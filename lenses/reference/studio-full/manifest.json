{
  "glf": "1.0",
  "id": "goss.reference.studio-full",
  "version": "1.0.0",
  "display_name": "Studio Full",
  "engine_compat": ">=0.5",
  "capabilities": ["face"],
  "parameters": [
    {"name": "smooth_amount", "type": "float", "default": 0.5, "min": 0.0, "max": 1.0}
  ],
  "nodes": [
    {"id": "face", "type": "beauty.face", "inputs": {"frame": "camera"}, "params": {"smooth": "$smooth_amount", "whiten": 0.2}},
    {"id": "grade", "type": "grade.pass", "inputs": {"frame": "camera"}, "params": {}, "grade": {"exposure": 0.08, "contrast": 1.1, "saturation": 1.15, "temperature": 0.04}},
    {"id": "glow", "type": "bloom.pass", "inputs": {"frame": "grade"}, "params": {}, "bloom": {"threshold": 0.6, "intensity": 0.5}},
    {"id": "ember", "type": "model.gltf", "inputs": {"frame": "glow"}, "params": {},
     "particles": {"count": 128, "gravity": 9.8, "speed": 2.0, "lifetime": 2.0, "fade": true, "cool": [0.7, 0.05, 0.0]}}
  ],
  "triggers": []
}

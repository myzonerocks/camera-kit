{
  "glf": "1.0",
  "id": "kit.reference.beauty-baseline",
  "version": "1.0.0",
  "display_name": "Beauty Baseline",
  "engine_compat": ">=0.5",
  "capabilities": ["face"],
  "parameters": [
    {"name": "smooth_amount", "type": "float", "default": 0.5, "min": 0.0, "max": 1.0},
    {"name": "whiten_amount", "type": "float", "default": 0.3, "min": 0.0, "max": 1.0}
  ],
  "nodes": [
    {"id": "face", "type": "beauty.face", "inputs": {"frame": "camera"}, "params": {"smooth": "$smooth_amount", "whiten": "$whiten_amount"}}
  ],
  "triggers": [
    {"when": "face.present", "action": {"kind": "param_ramp", "target": "smooth_amount", "to": 0.8, "duration_ms": 300}}
  ]
}

// Single-thread standard thread surface for the web tracking module. The
// sources that name std::thread only spawn when a worker pool is sized
// above one, which this module never configures; construction with a
// callable is therefore a hard stop rather than silent misbehavior.
#pragma once

#include <cstdlib>
#include <functional>
#include <utility>

namespace std {

class thread {
 public:
  class id {
   public:
    constexpr id() noexcept = default;
    friend bool operator==(id, id) noexcept { return true; }
    friend bool operator!=(id, id) noexcept { return false; }
    friend bool operator<(id, id) noexcept { return false; }
    template <class Stream>
    friend Stream& operator<<(Stream& stream, id) {
      return stream << 0;
    }
  };

  thread() noexcept = default;
  template <class F, class... Args>
  explicit thread(F&&, Args&&...) {
    abort();
  }
  thread(const thread&) = delete;
  thread(thread&&) noexcept = default;
  thread& operator=(thread&&) noexcept = default;
  bool joinable() const noexcept { return false; }
  void join() {}
  void detach() {}
  id get_id() const noexcept { return id{}; }
  static unsigned hardware_concurrency() noexcept { return 1; }
};

namespace this_thread {
inline thread::id get_id() noexcept {
  return thread::id{};
}
inline void yield() noexcept {}
template <class Rep, class Period>
void sleep_for(const Rep&, const Period&) {}
template <class Duration>
void sleep_for(const Duration&) {}
template <class TimePoint>
void sleep_until(const TimePoint&) {}
}  // namespace this_thread

template <>
struct hash<thread::id> {
  size_t operator()(thread::id) const noexcept { return 0; }
};

}  // namespace std

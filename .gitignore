# Re-include every tree this repository owns. A contributor's global ignore
# file can carry patterns that happen to match a directory this repository
# owns, silently excluding source. Re-including every tree makes the
# repository's own layout authoritative regardless of what a personal ignore
# file says. The source gate keeps this list in step with the tree.
!adapters/**
!core/**
!harness/**
!include/**
!lenses/**
!sdk/**
!third_party/**
!tools/**

# Docs are tracked, except the private dev docs under docs/private, which are
# local only and never committed. One directory keeps sensitive material in
# one place without listing each file.
!docs/**
docs/private/

# Build outputs and caches, never source. Compiler scratch artifacts are
# named here so this file, not a contributor's global ignore, is what hides
# them, and the gate keeps flagging anything a foreign layer hides.
.zig-cache/
zig-out/
a.out
*.o

# Developer-local config such as device-lab paths and signing identities.
.local/
.DS_Store

# Vendored engine caches and download archives, rebuilt from the pins in
# third_party by zig build vendor-sync. The pin files are tracked; the
# fetched trees and tarballs are not.
.vendor/
.vendor-archives/

# Model weights and task bundles, fetched by zig build fetch-models and
# digest-verified against the tracked models.lock. Runtime artifacts, never
# committed.
.models/

# Compiled shader bytecode packaged from lenses/reference/ by zig build
# lens-package-reference (--package output), read by the tracking harness.
# Build artifacts, rebuilt from tracked .glsl source every run.
.lens-packages/

# SDK build detritus.
sdk/swift/**/*.xcodeproj/
sdk/swift/demo/Sources/Info.plist
sdk/swift/**/xcuserdata/
sdk/swift/**/DerivedData/
sdk/kotlin/.gradle/
sdk/kotlin/**/build/
# The root Package.swift manifest builds under a root-level .build/ and
# .swiftpm/, the same as sdk/swift/'s own manifest does under its own.
.build/
.swiftpm/
sdk/kotlin/local.properties
sdk/ts/node_modules/
sdk/ts/dist/
sdk/ts/demo/dist.js
sdk/ts/demo/tracking-worker.js
sdk/ts/demo/gosslens_web.js
sdk/ts/demo/gosslens_web.wasm
sdk/ts/demo/webgpu/
sdk/ts/demo/gosslens_tracking.wasm
sdk/ts/demo/face_landmarker.task
sdk/ts/demo/beauty-baseline.manifest.json
sdk/ts/**/*.wasm.map

# Model assets are synced from .models at app build time, never tracked.
sdk/kotlin/demo/src/main/assets/

# Raster images are fetched corpus or scratch artifacts, never source -
# except a reference lens's own assets/*.png (lut.pass and blend.pass
# name an asset by id the same way shader.pass names a .glsl source
# file) and the web demo's own beauty LUT textures, copied in once
# rather than fetched at build time.
*.jpg
*.jpeg
*.png
!lenses/**/*.png
!sdk/ts/demo/res/*.png
*.webp
*.bmp

# ── Re-include every tree this repository owns ─────────────────────────────
# A contributor's global ignore file can carry patterns that happen to match a
# directory this repository owns, silently excluding source. Re-including every
# tree makes the repository's own layout authoritative regardless of what a
# personal ignore file says. Kept in step with the tree by the source-tracked
# gate, which derives its list from the directories that exist.
!adapters/**
!core/**
!harness/**
!include/**
!lenses/**
!shells/**
!third_party/**
!tools/**

# ── Docs ───────────────────────────────────────────────────────────────────
# Docs are tracked, except the private dev docs — the engineering instruction,
# roadmap drafts, UI/UX design references, and anything owner-eyes-only — which
# live under docs/private and are local-only, never committed. One directory
# keeps sensitive material in one place without listing each file.
!docs/**
docs/private/

# ── Build outputs and caches — never source ────────────────────────────────
.zig-cache/
zig-out/

# ── Developer-local config (device-lab paths, signing identities) ──────────
.local/
.DS_Store

# ── Vendored engine caches and download archives, rebuilt from the pins in
#    third_party/ by `zig build vendor-sync`. The pin files ARE tracked; the
#    fetched trees and tarballs are not. ─────────────────────────────────────
.vendor/
.vendor-archives/

# ── Model weights and task bundles (MediaPipe .task files, any future GGUF),
#    fetched once by `zig build fetch-models`, digest-verified against the
#    tracked models.lock. A runtime artifact, never committed. ───────────────
.models/

# ── Shell build detritus ────────────────────────────────────────────────────
shells/swift/.build/
shells/swift/**/DerivedData/
shells/kotlin/.gradle/
shells/kotlin/**/build/
shells/ts/node_modules/
shells/ts/dist/
shells/ts/**/*.wasm.map
